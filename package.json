{
  "name": "watch-party",
  "version": "1.0.0",
  "private": true,
  "description": "Stream movies from your PC to friends in a synced watch party.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "build:extensions": "node build/build-extensions.js",
    "build:extension-store": "node build/build-extensions.js --store",
    "benchmark:sync": "node benchmark/sync-benchmark.js --write",
    "test": "node --test test/*.test.js",
    "audit:unused": "npx --yes knip@6.44.1 --config build/knip.json",
    "test:ffmpeg": "node benchmark/ffmpeg-compatibility.js"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "dependencies": {
    "hls.js": "1.7.3",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  }
}
