{
  "manifest_version": 3,
  "name": "Watch Party Sync",
  "version": "1.15.0",
  "description": "Keeps Netflix, Prime Video, Hulu, Peacock, Crunchyroll, Paramount+, Max, Disney+, YouTube, and any website the host opens in the Watch Party window, in sync with your Watch Party.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Watch Party: show the party panel",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "webNavigation"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/join/*",
        "http://localhost/host/*",
        "http://127.0.0.1/host/*"
      ],
      "js": [
        "party.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "https://*.netflix.com/*",
    "https://*.primevideo.com/*",
    "https://*.amazon.com/*",
    "https://*.hulu.com/*",
    "https://*.peacocktv.com/*",
    "https://*.crunchyroll.com/*",
    "https://*.paramountplus.com/*",
    "https://*.max.com/*",
    "https://*.hbomax.com/*",
    "https://*.disneyplus.com/*",
    "https://tv.apple.com/*",
    "https://*.youtube.com/*",
    "https://*.apple.com/*",
    "<all_urls>"
  ]
}
