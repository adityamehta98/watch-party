{
  "manifest_version": 3,
  "name": "Watch Party Sync",
  "version": "1.10.0",
  "description": "Keeps streaming video in sync with your Watch Party while blocking ads only on host-selected custom sites.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Watch Party: show party controls",
    "default_popup": "sidebar.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "webNavigation"
  ],
  "background": {
    "service_worker": "safari-background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/join/*",
        "http://localhost/host/*",
        "http://127.0.0.1/host/*"
      ],
      "js": ["party.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.netflix.com/*",
        "https://*.primevideo.com/*",
        "https://*.amazon.com/*",
        "https://*.hulu.com/*",
        "https://*.peacocktv.com/*",
        "https://*.crunchyroll.com/*",
        "https://*.paramountplus.com/*",
        "https://*.max.com/*",
        "https://*.hbomax.com/*",
        "https://*.disneyplus.com/*",
        "https://tv.apple.com/*",
        "https://*.youtube.com/*"
      ],
      "js": ["services.js", "service.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.netflix.com/*"],
      "js": ["netflix-main.js"],
      "world": "MAIN",
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["custom-gate.js"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://*.netflix.com/*",
    "https://*.primevideo.com/*",
    "https://*.amazon.com/*",
    "https://*.hulu.com/*",
    "https://*.peacocktv.com/*",
    "https://*.crunchyroll.com/*",
    "https://*.paramountplus.com/*",
    "https://*.max.com/*",
    "https://*.hbomax.com/*",
    "https://*.disneyplus.com/*",
    "https://tv.apple.com/*",
    "https://*.youtube.com/*",
    "https://*.apple.com/*",
    "<all_urls>"
  ]
}
